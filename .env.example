# ---- Dhan credentials (never commit the real .env) --------------------------
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional: read the token from a file instead (re-read on every call, so a
# daily rotation only needs the file to be replaced; no restart required).
# DHAN_TOKEN_FILE=/etc/dhan-quant/token

# ---- Telegram alerts ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Engine -------------------------------------------------------------------
INDICES=NIFTY,BANKNIFTY,FINNIFTY,SENSEX,BANKEX
STRIKE_WINDOW=15
WS_FULL_WINDOW=15
SNAPSHOT_INTERVAL_S=15
CHAIN_MIN_INTERVAL_S=3.2
WS_STALE_S=20
ALERT_COOLDOWN_S=900
EVENT_SIGMA_K=3.0
MIN_SAMPLES_PATTERN=30
COST_BPS_ROUNDTRIP=6
RISK_FREE_RATE=0.065
RESEARCH_EVERY_S=1800
HEALTH_PORT=8787
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
HOLIDAYS_FILE=holidays.txt
# Extra holidays, comma separated YYYY-MM-DD
HOLIDAYS=
# Optional breadth universe, e.g. NSE_EQ:2885,NSE_EQ:1333
BREADTH_CONSTITUENTS=

# ---- Technical strategy / index.html -------------------------------------------
RISK_RUPEES=5000
MAX_SPREAD_PCT=1.0
# index.html is served at http://HEALTH_HOST:HEALTH_PORT/ . Keep 127.0.0.1 and use an
# SSH tunnel (ssh -L 8787:127.0.0.1:8787 user@vps), or set 0.0.0.0 AND a token:
HEALTH_HOST=127.0.0.1
DASHBOARD_TOKEN=
