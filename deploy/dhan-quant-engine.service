[Unit]
Description=Dhan Quant Intelligence Engine (read-only market research)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=dhan
Group=dhan
WorkingDirectory=/opt/dhan-quant
EnvironmentFile=/opt/dhan-quant/.env
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
ExecStart=/opt/dhan-quant/.venv/bin/python /opt/dhan-quant/main.py run --headless
Restart=always
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryMax=2G
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/dhan-quant/data /opt/dhan-quant/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
