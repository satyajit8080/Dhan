# Copy to .env. Never commit .env or token files.
DHAN_CLIENT_ID=
# Prefer DHAN_TOKEN_FILE (rotate by rewriting the file; no restart needed).
DHAN_TOKEN_FILE=./secrets/dhan.token
# DHAN_ACCESS_TOKEN=
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master-detailed.csv
CHAIN_COOLDOWN_S=3
CHAIN_MAX_CONCURRENCY=4
HISTORICAL_COOLDOWN_S=3
HISTORICAL_MAX_CONCURRENCY=1
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://doi:CHANGE_ME@localhost:5432/doi
REDIS_URL=redis://localhost:6379/0
PAPER_STARTING_CAPITAL=500000
PAPER_LEDGER_PATH=./secrets/paper-ledger.jsonl
PAPER_FEED_INTERVAL_S=3
