# Copy to .env. Never commit .env or token files.
DHAN_CLIENT_ID=
# Prefer DHAN_TOKEN_FILE (rotate by rewriting the file; no restart needed).
DHAN_TOKEN_FILE=./secrets/dhan.token
# DHAN_ACCESS_TOKEN=
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master-detailed.csv
CHAIN_COOLDOWN_S=3
CHAIN_MAX_CONCURRENCY=4
HISTORICAL_COOLDOWN_S=3
HISTORICAL_MAX_CONCURRENCY=1
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://doi:CHANGE_ME@localhost:5432/doi
REDIS_URL=redis://localhost:6379/0
PAPER_STARTING_CAPITAL=500000
PAPER_LEDGER_PATH=./secrets/paper-ledger.jsonl
PAPER_FEED_INTERVAL_S=3
# Live Market Feed (WebSocket, read-only). Off by default.
DHAN_FEED_ENABLED=false
# HOLIDAYS_FILE=/path/to/nse-holidays.yaml
# --- Phase 7 AI research (Grok). Disabled unless AI_ENABLED=true AND XAI_API_KEY is set. ---
AI_ENABLED=false
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
LLM_FAST_MODEL=grok-4.20-non-reasoning
LLM_REASONING_MODEL=grok-4.20-reasoning
# Hard monthly cap; the API refuses to raise it above this value.
LLM_MONTHLY_LIMIT_INR=3000
LLM_SAFETY_BUFFER_INR=150
# Conversion assumptions (UNVERIFIED; keep conservative)
LLM_FX_INR_PER_USD=90
LLM_TAX_MULTIPLIER=1.18
AI_WORKER_INTERVAL_S=60
