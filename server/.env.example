# bull50-dhan server configuration. Copy to .env and fill in locally.
# NEVER commit .env. The server does not read this file itself (no dotenv):
# export the variables in your shell, or load them with your process manager.

# --- credentials (required) -------------------------------------------------
DHAN_CLIENT_ID=
# Either a token in the environment...
DHAN_ACCESS_TOKEN=
# ...or a path to a file holding only the token (re-read on every call, so it
# can be rotated without a restart). Leave DHAN_ACCESS_TOKEN empty if used.
DHAN_TOKEN_FILE=

# --- optional settings (defaults shown) ---------------------------------------
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_RISK_FREE_RATE=0.065
# Local daily request budget. Dhan documents 100000/day for Data APIs.
DHAN_DAILY_QUOTA=7000
DHAN_MAX_QUOTE_AGE_MS=15000
DHAN_MAX_SNAPSHOT_SKEW_MS=3000
DHAN_EXPIRY_TTL_MS=21600000
DHAN_SCRIP_TTL_MS=43200000
# debug | info | warn | error | silent
DHAN_LOG_LEVEL=info
# Rolling price-history store (defaults to the OS temp directory).
DHAN_HISTORY_FILE=
