{
  "name": "bull50-dhan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:golden": "vitest run test/golden",
    "smoke": "tsx scripts/smoke.ts",
    "bundle": "esbuild src/mcpServer.ts --bundle --platform=node --target=node20 --format=cjs --outfile=../plugin/server/mcpServer.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "esbuild": "^0.24.0"
  }
}
